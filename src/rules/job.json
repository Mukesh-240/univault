{
  "id": "job",
  "purpose": "job",
  "title": "Job application",
  "title_te": "ఉద్యోగ దరఖాస్తు",
  "disclaimer": "Demo rules, not official requirements.",
  "disclaimer_te": "డెమో నియమాలు, అధికారిక అవసరాలు కావు.",
  "source": "UNIVAULT demo rule pack v1",
  "lastReviewed": "2026-10-24",
  "rules": [
    { "id": "job.id_present", "label": "Identity card is in the vault", "label_te": "గుర్తింపు కార్డు వాల్ట్‌లో ఉంది", "predicate": "doc_exists", "args": { "doc_type": "id_card" } },
    { "id": "job.degree_present", "label": "Degree certificate is in the vault", "label_te": "డిగ్రీ సర్టిఫికేట్ వాల్ట్‌లో ఉంది", "predicate": "doc_exists", "args": { "doc_type": "degree_certificate" } },
    { "id": "job.degree_verified", "label": "Degree certificate is verified with the issuer", "label_te": "డిగ్రీ సర్టిఫికేట్ జారీదారుతో ధృవీకరించబడింది", "predicate": "verified", "args": { "doc_type": "degree_certificate" } },
    { "id": "job.names_match", "label": "Name on ID and degree belong to the same person", "label_te": "గుర్తింపు కార్డు మరియు డిగ్రీపై పేరు ఒకే వ్యక్తిది", "predicate": "name_consistent", "args": { "doc_types": ["id_card", "degree_certificate"] } },
    { "id": "job.adult", "label": "Applicant is at least 18", "label_te": "దరఖాస్తుదారుకు కనీసం 18 సంవత్సరాలు", "predicate": "age_at_least", "args": { "years": 18, "doc_type": "id_card", "field": "dob" } }
  ],
  "allowed_fields": [
    "id_card.name",
    "id_card.id_number_last4",
    "id_card.over_18",
    "degree_certificate.name",
    "degree_certificate.degree",
    "degree_certificate.branch",
    "degree_certificate.year_of_passing"
  ],
  "alternatives": {"id_card.id_number":"id_card.id_number_last4","id_card.dob":"id_card.over_18","marksheet.total_marks":"marksheet.passed"}
}
