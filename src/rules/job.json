{
  "id": "job",
  "purpose": "job",
  "title": "Job application",
  "disclaimer": "Demo rules, not official requirements.",
  "source": "UNIVAULT demo rule pack v1",
  "lastReviewed": "2026-10-24",
  "rules": [
    { "id": "job.id_present", "label": "Identity card is in the vault", "predicate": "doc_exists", "args": { "doc_type": "id_card" } },
    { "id": "job.degree_present", "label": "Degree certificate is in the vault", "predicate": "doc_exists", "args": { "doc_type": "degree_certificate" } },
    { "id": "job.degree_verified", "label": "Degree certificate is verified with the issuer", "predicate": "verified", "args": { "doc_type": "degree_certificate" } },
    { "id": "job.names_match", "label": "Name on ID and degree belong to the same person", "predicate": "name_consistent", "args": { "doc_types": ["id_card", "degree_certificate"] } },
    { "id": "job.adult", "label": "Applicant is at least 18", "predicate": "age_at_least", "args": { "years": 18, "doc_type": "id_card", "field": "dob" } }
  ],
  "allowed_fields": [
    "id_card.name", "id_card.id_number_last4", "id_card.over_18",
    "degree_certificate.name", "degree_certificate.degree", "degree_certificate.branch", "degree_certificate.year_of_passing"
  ],
  "alternatives": { "id_card.id_number": "id_card.id_number_last4", "id_card.dob": "id_card.over_18", "marksheet.total_marks": "marksheet.passed" }
}
