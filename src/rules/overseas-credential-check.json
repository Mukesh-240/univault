{
  "id": "overseas-credential-check",
  "purpose": "overseas_credential_check",
  "title": "Overseas credential check",
  "disclaimer": "Demo rules, not official requirements.",
  "source": "UNIVAULT demo rule pack v1",
  "lastReviewed": "2026-10-24",
  "rules": [
    { "id": "occ.degree_present", "label": "Degree certificate is in the vault", "predicate": "doc_exists", "args": { "doc_type": "degree_certificate" } },
    { "id": "occ.degree_verified", "label": "Degree certificate is verified with the issuer", "predicate": "verified", "args": { "doc_type": "degree_certificate" } },
    { "id": "occ.marks_confirmed", "label": "Marksheet scan has been confirmed by you", "predicate": "scan_confirmed", "args": { "doc_type": "marksheet" } },
    { "id": "occ.names_match", "label": "Names on ID, degree and marksheet belong to the same person", "predicate": "name_consistent", "args": { "doc_types": ["id_card", "degree_certificate", "marksheet"] } }
  ],
  "allowed_fields": [
    "degree_certificate.name", "degree_certificate.degree", "degree_certificate.branch", "degree_certificate.cgpa",
    "degree_certificate.year_of_passing", "degree_certificate.serial", "marksheet.total_marks", "marksheet.result", "marksheet.passed"
  ],
  "alternatives": { "id_card.id_number": "id_card.id_number_last4", "id_card.dob": "id_card.over_18" }
}
