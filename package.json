{
  "name": "univault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "synth": "tsx synthetic/generate.ts",
    "synth:all": "tsx synthetic/generate.ts --set dev --seed 7 && tsx synthetic/generate.ts --set heldout --seed 99 && tsx synthetic/generate.ts --set showcase --seed 2026",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "data-card": "tsx scripts/data-card.ts",
    "scans": "tsx synthetic/scans.ts",
    "db:check": "tsx --env-file=.env.local scripts/db-check.ts",
    "e2e": "playwright test",
    "ocr:fixtures": "tsx scripts/ocr-fixtures.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "record-demo": "tsx scripts/record-demo.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "1.51.0",
    "motion": "13.5.1",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^6.0.1",
    "unpdf": "1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.28"
  },
  "license": "MIT"
}
